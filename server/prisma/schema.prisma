generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum ACUnitStatus {
  ACTIVE
  INACTIVE
  REMOVED
}

enum ACUnitType {
  SPLIT
  CASSETTE
  CEILING
  FLOOR_STANDING
  VRV
  VRF
  WINDOW
  CENTRAL
  PORTABLE
  OTHER
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum RequestSource {
  PHONE
  WHATSAPP
  WEBSITE
  WALK_IN
  REFERRAL
  INTERNAL
  OTHER
}

enum ServiceRequestStatus {
  NEW
  CONFIRMED
  SCHEDULED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  INVOICED
  PAID
  CANCELLED
  RESCHEDULED
  REJECTED
}

enum WorkOrderStatus {
  DRAFT
  SCHEDULED
  EN_ROUTE
  ARRIVED
  IN_PROGRESS
  WAITING_APPROVAL
  WAITING_PARTS
  COMPLETED
  CANCELLED
}

enum AssignmentStatus {
  ASSIGNED
  ACCEPTED
  REJECTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum PhotoType {
  BEFORE
  DURING
  AFTER
  DAMAGE
  METER
  SERIAL_NUMBER
  OTHER
}

enum InventoryItemType {
  PART
  MATERIAL
  CONSUMABLE
  TOOL
}

enum StockMovementType {
  PURCHASE
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  USED
  RETURNED
  TRANSFER_IN
  TRANSFER_OUT
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  VOID
  OVERDUE
}

enum InvoiceItemType {
  SERVICE
  PART
  LABOR
  DISCOUNT
  OTHER
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  QRIS
  DEBIT_CARD
  CREDIT_CARD
  E_WALLET
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum MaintenanceContractStatus {
  DRAFT
  ACTIVE
  PAUSED
  EXPIRED
  CANCELLED
}

enum MaintenanceFrequency {
  MONTHLY
  BIMONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
  CUSTOM
}

enum MaintenanceScheduleStatus {
  PENDING
  SCHEDULED
  COMPLETED
  MISSED
  CANCELLED
}

model Business {
  id         String   @id @default(cuid())
  code       String   @unique
  name       String
  phone      String?
  email      String?
  address    String?
  city       String?
  province   String?
  postalCode String?
  timezone   String   @default("Asia/Jakarta")
  currency   String   @default("IDR")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  branches             Branch[]
  users                User[]
  roles                Role[]
  customers            Customer[]
  services             Service[]
  serviceRequests      ServiceRequest[]
  workOrders           WorkOrder[]
  inventoryItems       InventoryItem[]
  invoices             Invoice[]
  payments             Payment[]
  maintenanceContracts MaintenanceContract[]
  auditLogs            AuditLog[]

  @@index([isActive])
}

model Branch {
  id         String   @id @default(cuid())
  businessId String
  code       String
  name       String
  phone      String?
  email      String?
  address    String?
  city       String?
  province   String?
  postalCode String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  users           User[]
  serviceRequests ServiceRequest[]
  workOrders      WorkOrder[]
  inventoryItems  InventoryItem[]

  @@unique([businessId, code])
  @@index([businessId])
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  createdAt   DateTime @default(now())

  rolePermissions RolePermission[]
}

model Role {
  id          String   @id @default(cuid())
  businessId  String
  code        String
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  users           User[]
  rolePermissions RolePermission[]

  @@unique([businessId, code])
  @@index([businessId])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model User {
  id           String     @id @default(cuid())
  businessId   String
  branchId     String?
  roleId       String
  name         String
  username     String
  email        String?
  phone        String?
  passwordHash String
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  role     Role     @relation(fields: [roleId], references: [id])

  technicianProfile TechnicianProfile?

  createdServiceRequests ServiceRequest[] @relation("ServiceRequestCreatedBy")
  assignedWorkOrders     WorkOrder[]      @relation("WorkOrderCreatedBy")
  auditLogs              AuditLog[]

  @@unique([businessId, username])
  @@index([businessId])
  @@index([branchId])
  @@index([roleId])
  @@index([status])
}

model Customer {
  id                String         @id @default(cuid())
  businessId        String
  customerCode      String
  name              String
  phone             String?
  whatsapp          String?
  email             String?
  status            CustomerStatus @default(ACTIVE)
  notes             String?
  totalOrders       Int            @default(0)
  totalSpent        Decimal        @default(0) @db.Decimal(15, 2)
  averageOrderValue Decimal        @default(0) @db.Decimal(15, 2)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  properties           Property[]
  serviceRequests      ServiceRequest[]
  workOrders           WorkOrder[]
  invoices             Invoice[]
  payments             Payment[]
  maintenanceContracts MaintenanceContract[]

  @@unique([businessId, customerCode])
  @@index([businessId])
  @@index([phone])
  @@index([whatsapp])
  @@index([status])
}

model Property {
  id         String   @id @default(cuid())
  customerId String
  name       String
  address    String
  city       String?
  province   String?
  postalCode String?
  latitude   Decimal? @db.Decimal(10, 7)
  longitude  Decimal? @db.Decimal(10, 7)
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  acUnits         ACUnit[]
  serviceRequests ServiceRequest[]
  workOrders      WorkOrder[]

  @@index([customerId])
}

model ACUnit {
  id               String       @id @default(cuid())
  propertyId       String
  unitCode         String
  brand            String?
  model            String?
  serialNumber     String?
  type             ACUnitType
  capacityBtu      Int?
  capacityPk       Decimal?     @db.Decimal(5, 2)
  refrigerant      String?
  installationDate DateTime?
  warrantyUntil    DateTime?
  status           ACUnitStatus @default(ACTIVE)
  location         String?
  floor            String?
  notes            String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  serviceRequests          ServiceRequest[]
  workOrders               WorkOrder[]
  maintenanceContractUnits MaintenanceContractUnit[]

  @@unique([propertyId, unitCode])
  @@index([propertyId])
  @@index([serialNumber])
  @@index([status])
}

model TechnicianProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  employeeCode   String
  specialization String?
  skillLevel     String?
  hourlyRate     Decimal? @db.Decimal(15, 2)
  isAvailable    Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignments WorkOrderAssignment[]

  @@index([employeeCode])
}

model Service {
  id          String   @id @default(cuid())
  businessId  String
  code        String
  name        String
  description String?
  basePrice   Decimal  @db.Decimal(15, 2)
  durationMin Int?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  serviceRequests ServiceRequest[]
  invoiceItems    InvoiceItem[]

  @@unique([businessId, code])
  @@index([businessId])
  @@index([isActive])
}

model ServiceRequest {
  id            String               @id @default(cuid())
  businessId    String
  branchId      String?
  customerId    String
  propertyId    String?
  acUnitId      String?
  serviceId     String?
  requestNo     String
  source        RequestSource
  status        ServiceRequestStatus @default(NEW)
  priority      Priority             @default(NORMAL)
  requestedAt   DateTime             @default(now())
  requestedDate DateTime?
  complaint     String
  description   String?
  notes         String?
  createdById   String
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  business  Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch    Branch?   @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customer  Customer  @relation(fields: [customerId], references: [id])
  property  Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  acUnit    ACUnit?   @relation(fields: [acUnitId], references: [id], onDelete: SetNull)
  service   Service?  @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  createdBy User      @relation("ServiceRequestCreatedBy", fields: [createdById], references: [id])

  workOrder WorkOrder?

  @@unique([businessId, requestNo])
  @@index([businessId])
  @@index([customerId])
  @@index([propertyId])
  @@index([acUnitId])
  @@index([status])
  @@index([requestedDate])
}

model WorkOrder {
  id               String          @id @default(cuid())
  businessId       String
  branchId         String?
  serviceRequestId String?         @unique
  customerId       String
  propertyId       String?
  acUnitId         String?
  workOrderNo      String
  status           WorkOrderStatus @default(DRAFT)
  priority         Priority        @default(NORMAL)
  scheduledAt      DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  complaint        String
  technicianNotes  String?
  customerNotes    String?
  createdById      String
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch         Branch?         @relation(fields: [branchId], references: [id], onDelete: SetNull)
  serviceRequest ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)
  customer       Customer        @relation(fields: [customerId], references: [id])
  property       Property?       @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  acUnit         ACUnit?         @relation(fields: [acUnitId], references: [id], onDelete: SetNull)
  createdBy      User            @relation("WorkOrderCreatedBy", fields: [createdById], references: [id])

  assignments WorkOrderAssignment[]
  diagnosis   WorkOrderDiagnosis?
  checklist   WorkOrderChecklistItem[]
  photos      WorkOrderPhoto[]
  labor       WorkOrderLabor[]
  partUsages  WorkOrderPartUsage[]
  invoice     Invoice?

  @@unique([businessId, workOrderNo])
  @@index([businessId])
  @@index([customerId])
  @@index([acUnitId])
  @@index([status])
  @@index([scheduledAt])
}

model WorkOrderAssignment {
  id           String           @id @default(cuid())
  workOrderId  String
  technicianId String
  status       AssignmentStatus @default(ASSIGNED)
  assignedAt   DateTime         @default(now())
  acceptedAt   DateTime?
  completedAt  DateTime?
  notes        String?

  workOrder  WorkOrder         @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  technician TechnicianProfile @relation(fields: [technicianId], references: [id])

  @@unique([workOrderId, technicianId])
  @@index([technicianId])
  @@index([status])
}

model WorkOrderDiagnosis {
  id             String   @id @default(cuid())
  workOrderId    String   @unique
  diagnosis      String
  actionTaken    String?
  recommendation String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
}

model WorkOrderChecklistItem {
  id          String   @id @default(cuid())
  workOrderId String
  item        String
  isCompleted Boolean  @default(false)
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
}

model WorkOrderPhoto {
  id          String    @id @default(cuid())
  workOrderId String
  type        PhotoType
  url         String
  caption     String?
  createdAt   DateTime  @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
  @@index([type])
}

model WorkOrderLabor {
  id          String   @id @default(cuid())
  workOrderId String
  description String
  quantity    Decimal  @default(1) @db.Decimal(12, 3)
  unitPrice   Decimal  @db.Decimal(15, 2)
  total       Decimal  @db.Decimal(15, 2)
  createdAt   DateTime @default(now())

  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
}

model InventoryItem {
  id         String            @id @default(cuid())
  businessId String
  branchId   String?
  sku        String
  name       String
  type       InventoryItemType
  unit       String
  quantity   Decimal           @default(0) @db.Decimal(12, 3)
  minimumQty Decimal           @default(0) @db.Decimal(12, 3)
  unitCost   Decimal           @default(0) @db.Decimal(15, 2)
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  branch   Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  movements  StockMovement[]
  partUsages WorkOrderPartUsage[]

  @@unique([businessId, sku])
  @@index([businessId])
  @@index([branchId])
  @@index([type])
}

model StockMovement {
  id              String            @id @default(cuid())
  inventoryItemId String
  type            StockMovementType
  quantity        Decimal           @db.Decimal(12, 3)
  unitCost        Decimal?          @db.Decimal(15, 2)
  referenceType   String?
  referenceId     String?
  notes           String?
  createdAt       DateTime          @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
  @@index([type])
  @@index([createdAt])
}

model WorkOrderPartUsage {
  id              String   @id @default(cuid())
  workOrderId     String
  inventoryItemId String
  quantity        Decimal  @db.Decimal(12, 3)
  unitPrice       Decimal  @db.Decimal(15, 2)
  total           Decimal  @db.Decimal(15, 2)
  createdAt       DateTime @default(now())

  workOrder     WorkOrder     @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([workOrderId])
  @@index([inventoryItemId])
}

model Invoice {
  id          String        @id @default(cuid())
  businessId  String
  workOrderId String        @unique
  customerId  String
  invoiceNo   String
  status      InvoiceStatus @default(DRAFT)
  subtotal    Decimal       @default(0) @db.Decimal(15, 2)
  discount    Decimal       @default(0) @db.Decimal(15, 2)
  tax         Decimal       @default(0) @db.Decimal(15, 2)
  total       Decimal       @default(0) @db.Decimal(15, 2)
  issuedAt    DateTime?
  dueAt       DateTime?
  paidAt      DateTime?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  business  Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id])
  customer  Customer  @relation(fields: [customerId], references: [id])

  items    InvoiceItem[]
  payments Payment[]

  @@unique([businessId, invoiceNo])
  @@index([businessId])
  @@index([customerId])
  @@index([status])
  @@index([dueAt])
}

model InvoiceItem {
  id          String          @id @default(cuid())
  invoiceId   String
  serviceId   String?
  type        InvoiceItemType
  description String
  quantity    Decimal         @default(1) @db.Decimal(12, 3)
  unitPrice   Decimal         @db.Decimal(15, 2)
  total       Decimal         @db.Decimal(15, 2)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@index([serviceId])
}

model Payment {
  id          String        @id @default(cuid())
  businessId  String
  customerId  String
  invoiceId   String?
  amount      Decimal       @db.Decimal(15, 2)
  method      PaymentMethod
  status      PaymentStatus @default(PENDING)
  referenceNo String?
  paidAt      DateTime?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id])
  invoice  Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([customerId])
  @@index([invoiceId])
  @@index([status])
}

model MaintenanceContract {
  id         String                    @id @default(cuid())
  businessId String
  customerId String
  contractNo String
  name       String
  status     MaintenanceContractStatus @default(DRAFT)
  frequency  MaintenanceFrequency
  startDate  DateTime
  endDate    DateTime?
  price      Decimal                   @db.Decimal(15, 2)
  notes      String?
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id])

  units     MaintenanceContractUnit[]
  schedules MaintenanceSchedule[]

  @@unique([businessId, contractNo])
  @@index([businessId])
  @@index([customerId])
  @@index([status])
}

model MaintenanceContractUnit {
  id         String @id @default(cuid())
  contractId String
  acUnitId   String

  contract MaintenanceContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  acUnit   ACUnit              @relation(fields: [acUnitId], references: [id])

  @@unique([contractId, acUnitId])
  @@index([acUnitId])
}

model MaintenanceSchedule {
  id          String                    @id @default(cuid())
  contractId  String
  scheduledAt DateTime
  status      MaintenanceScheduleStatus @default(PENDING)
  workOrderId String?
  notes       String?
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  contract MaintenanceContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@index([scheduledAt])
  @@index([status])
}

model AuditLog {
  id         String   @id @default(cuid())
  businessId String
  userId     String?
  action     String
  entity     String
  entityId   String?
  oldData    Json?
  newData    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([businessId])
  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
}
